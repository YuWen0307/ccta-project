# ============================================================
#  ccta-project  .gitignore
# ============================================================


# ------------------------------------------------------------
# 一、data / outputs：只保留目录骨架，不提交任何内容
# ------------------------------------------------------------
# 1) 先忽略这两个目录下的全部内容（含各级子目录与文件）
data/**
outputs/**

# 2) 再把目录本身及各级子目录重新纳入跟踪，使目录骨架得以保留
!data/
!data/**/
!outputs/
!outputs/**/

# 3) Git 本身不追踪空目录：请在需要保留的每一级目录中放一个
#    .gitkeep 占位文件（例如 data/raw/.gitkeep、outputs/reports/.gitkeep），
#    此处统一放行这些占位文件。
#    示例目录结构：
#      data/processed/.gitkeep
#      data/raw/.gitkeep
#      outputs/per_patient/.gitkeep
#      outputs/reports/.gitkeep
!.gitkeep


# ------------------------------------------------------------
# 二、Python 运行与构建产物
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/
.conda/

# 打包 / 分发产物
build/
dist/
*.egg-info/
.eggs/

# 测试与静态检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/


# ------------------------------------------------------------
# 三、模型与实验中间产物（如需要版本管理，请删除对应行）
# ------------------------------------------------------------
*.pkl
*.pickle
*.joblib
*.h5
*.ckpt
*.pt
*.pth
*.onnx
*.ptx


# ------------------------------------------------------------
# 四、日志与临时文件
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
*~


# ------------------------------------------------------------
# 五、IDE / 编辑器
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml


# ------------------------------------------------------------
# 六、操作系统自动生成的文件
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini


# ------------------------------------------------------------
# 七、敏感信息（务必不要提交）
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml
configs/local/
config.local.*


# ------------------------------------------------------------
# 八、必须提交的文件与目录（白名单，防止被上方规则误伤）
# ------------------------------------------------------------
!environment.yml
!README.md
!.gitignore
!configs/
!src/
!scripts/
!tests/

